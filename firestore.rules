rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection probe endpoint
    match /test/{docId} {
      allow get: if true;
    }

    // Entity validation functions
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'balance', 'createdAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.balance is number && data.balance >= 0 &&
             data.createdAt is string && data.createdAt.size() <= 60 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('password' in data) || (data.password is string && data.password.size() <= 10));
    }

    function isValidTransaction(data, expectedUserId) {
      return data.keys().hasAll(['id', 'userId', 'type', 'title', 'subtitle', 'amount', 'isCredit', 'status', 'reference']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId == expectedUserId &&
             data.type in ['deposit', 'transfer', 'airtime', 'data', 'promo', 'cashback'] &&
             data.title is string && data.title.size() <= 150 &&
             data.subtitle is string && data.subtitle.size() <= 200 &&
             data.amount is number && data.amount >= 0 &&
             data.isCredit is bool &&
             data.status in ['successful', 'pending', 'failed'] &&
             data.reference is string && data.reference.size() <= 100 &&
             (!('network' in data) || (data.network is string && data.network.size() <= 50)) &&
             (!('recipient' in data) || (data.recipient is string && data.recipient.size() <= 100)) &&
             (!('date' in data) || (data.date is string && data.date.size() <= 60)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    function isValidQuickCode(data, expectedUserId) {
      return data.keys().hasAll(['id', 'code', 'userId', 'amountPaid', 'createdAt', 'status']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId == expectedUserId &&
             data.code is string && data.code.size() <= 30 &&
             data.amountPaid is number && data.amountPaid >= 0 &&
             data.createdAt is string && data.createdAt.size() <= 60 &&
             data.status in ['unused', 'used'] &&
             (!('usedAt' in data) || (data.usedAt is string && data.usedAt.size() <= 60)) &&
             (!('usedForTxRef' in data) || (data.usedForTxRef is string && data.usedForTxRef.size() <= 100));
    }

    // Users Collection (Private User Profiles & Wallets)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // No blanket enumeration of users

      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == userId;

      allow update: if isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['balance']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'name', 'phone']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'name', 'phone', 'password'])
                       );

      allow delete: if false;

      // Transactions Subcollection (Master Gate: Enforced by Parent Path Owner)
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(transactionId) &&
                         isValidTransaction(incoming(), userId) &&
                         incoming().id == transactionId;

        allow update: if isOwner(userId) && isValidId(transactionId) &&
                         isValidTransaction(incoming(), userId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status']);

        allow delete: if false;
      }

      // QuickCodes Subcollection (Master Gate: Enforced by Parent Path Owner)
      match /quickCodes/{codeId} {
        allow get: if isOwner(userId) && isValidId(codeId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(codeId) &&
                         isValidQuickCode(incoming(), userId) &&
                         incoming().id == codeId;

        allow update: if isOwner(userId) && isValidId(codeId) &&
                         isValidQuickCode(incoming(), userId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedAt', 'usedForTxRef']);

        allow delete: if false;
      }
    }
  }
}
